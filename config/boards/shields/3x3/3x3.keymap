#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Position (row, column) below maps to the wiring in 3x3.overlay:
        //   row 0 = D0   row 1 = D1   row 2 = D2
        //   col 0 = D3   col 1 = D6   col 2 = D7
        // So the top-left key is D0-D3, the bottom-right key is D2-D7.
        default_layer { // Layer 0
            // -------------------------------------
            // |    N1     |    N2     |    N3     |
            // |    N4     |    N5     |    N6     |
            // |    N7     |    N8     | toggle L1 |
            // -------------------------------------
            bindings = <
                &kp N1  &kp N2  &kp N3
                &kp N4  &kp N5  &kp N6
                &kp N7  &kp N8  &tog 1
            >;
        };

        // Toggle (not hold) so layer changes survive without holding a key.
        // This layer only becomes reachable once the matrix is verified.
        media_layer { // Layer 1
            // -------------------------------------
            // |  out BLE  |  BT SEL 0 |  BT SEL 1 |
            // |  out USB  |  BT CLR   | studio    |
            // |  vol -    |  vol +    | back to L0|
            // -------------------------------------
            bindings = <
                &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1
                &out OUT_USB  &bt BT_CLR    &studio_unlock
                &kp C_VOL_DN  &kp C_VOL_UP  &tog 1
            >;
        };
    };
};
